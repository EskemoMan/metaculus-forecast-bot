# Local runs only. Copy to `.env` and fill in. `.env` is git-ignored: never commit it.
# In GitHub Actions these come from repository secrets instead.

# Required: Metaculus bot account token (Settings -> My Forecasting Bots)
METACULUS_TOKEN=REPLACE_ME

# Required: Google AI Studio API key (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME

# Strongly recommended: Tavily search key (free tier) - https://app.tavily.com
TAVILY_API_KEY=REPLACE_ME

# Optional
# GROQ_API_KEY=REPLACE_ME
# OPENROUTER_API_KEY=REPLACE_ME
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
